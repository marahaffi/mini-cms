                <input type="hidden" name="_token" value="TrGM0xxYDXDanvanVtP8MXNPO3ovJ8dO3kilVo2a" autocomplete="off">                <input type="hidden" name="_method" value="PATCH">
                <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">Dépublier</button>
            </form>

            <a href="http://localhost:8000/posts/9/edit" class="rounded-md border border-indigo-600 px-4 py-2 text-sm font-medium text-indigo-600 hover:bg-indigo-50">Modifier</a>

            <details open="">
                <summary class="cursor-pointer rounded-md border border-red-600 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50">Supprimer</summary>

                <form method="POST" action="http://localhost:8000/posts/9" class="mt-3 rounded-md border border-red-200 bg-red-50 p-4">
                    <input type="hidden" name="_token" value="TrGM0xxYDXDanvanVtP8MXNPO3ovJ8dO3kilVo2a" autocomplete="off">                    <input type="hidden" name="_method" value="DELETE">
                    <p class="mb-3 text-sm text-red-900">Cette action est définitive : l'article sera effacé de la base.</p>
                    <button type="submit" class="rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">Confirmer la suppression</button>
                </form>
